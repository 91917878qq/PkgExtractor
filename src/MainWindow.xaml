<Window x:Class="PkgExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PKG Extractor"
        Width="1000" Height="720"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource F.Ui}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CapBtn" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapClose" TargetType="Button" BasedOn="{StaticResource CapBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" Background="{StaticResource B.Bg}"
            BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" ClipToBounds="True">
                        <Image Source="Assets/app.ico" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="PKG Extractor" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Text}" />
                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                            Background="#1A6C8CFF" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v0.0.1" FontSize="10.5"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="最小化" />
                    <Button Style="{StaticResource CapBtn}" Content="&#xE922;" Click="Maximize_Click"
                            ToolTip="最大化" />
                    <Button Style="{StaticResource CapClose}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- drop zone -->
                <Border x:Name="DropZone" Grid.Row="0" Height="132" CornerRadius="12"
                        Background="{StaticResource B.Surface}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1.5"
                        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
                        MouseLeftButtonUp="DropZone_Click"
                        Cursor="Hand">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="DropIcon"
                                  Data="M 2,17 L 2,26 A 2,2 0 0 0 4,28 L 26,28 A 2,2 0 0 0 28,26 L 28,17 M 15,2 L 15,19 M 8,12 L 15,19 L 22,12"
                                  Stroke="{StaticResource B.Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="30" Height="30" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropTitle" Text="拖入 .pkg / .mpkg 文件"
                                       Margin="0,12,0,0" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Text}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropHint" Text="支持多文件与文件夹，也可以点击这里浏览"
                                       Margin="0,5,0,0" FontSize="12"
                                       Foreground="{StaticResource B.TextFaint}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- options -->
                <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                        Background="{StaticResource B.Surface}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="输出目录" VerticalAlignment="Center"
                                       Style="{StaticResource T.Label}" Margin="0,0,10,0" />

                            <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource B.Surface2}"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                <TextBox x:Name="OutputBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource B.Text}"
                                         CaretBrush="{StaticResource B.Text}"
                                         FontSize="12.5" Padding="10,7"
                                         FontFamily="{StaticResource F.Mono}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="解包结果写入这里" />
                            </Border>

                            <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0"
                                    Style="{StaticResource Btn.Ghost}" Click="BrowseOutput_Click" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <CheckBox x:Name="ChkConvert" Style="{StaticResource Cb}"
                                      Content="转换 TEX 贴图（PNG / GIF / MP4）"
                                      IsChecked="True" Margin="0,0,20,0" />
                            <CheckBox x:Name="ChkKeepTex" Style="{StaticResource Cb}"
                                      Content="保留原始 .tex" Margin="0,0,20,0" />
                            <CheckBox x:Name="ChkAllMips" Style="{StaticResource Cb}"
                                      Content="导出全部 mipmap 层级" Margin="0,0,20,0" />
                            <CheckBox x:Name="ChkSubfolder" Style="{StaticResource Cb}"
                                      Content="每个包单独建子目录" IsChecked="True" Margin="0,0,20,0" />
                            <CheckBox x:Name="ChkOverwrite" Style="{StaticResource Cb}"
                                      Content="覆盖同名文件" IsChecked="True" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- file list -->
                <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="10" ClipToBounds="True"
                        Background="{StaticResource B.Surface}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,11,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="QueueTitle" Text="待解包队列"
                                       Style="{StaticResource T.Title}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="添加文件" Style="{StaticResource Btn.Icon}"
                                        Click="AddFiles_Click" />
                                <Button Content="清空" Style="{StaticResource Btn.Icon}"
                                        Click="ClearQueue_Click" />
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="FileList" Style="{StaticResource Lv}"
                                  ItemContainerStyle="{StaticResource LvItem}"
                                  Margin="8,0,8,8">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource LvHeader}">
                                    <GridViewColumn Header="文件名" Width="360"
                                                    DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="大小" Width="100"
                                                    DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="类型" Width="90"
                                                    DisplayMemberBinding="{Binding KindText}" />
                                    <GridViewColumn Header="状态" Width="150"
                                                    DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Row="1" x:Name="EmptyHint"
                                   Text="队列是空的 — 把文件拖进来吧"
                                   FontSize="12.5" Foreground="{StaticResource B.TextFaint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- progress -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪"
                                   Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" x:Name="PercentText" Text=""
                                   Style="{StaticResource T.Label}"
                                   FontFamily="{StaticResource F.Mono}" />
                    </Grid>

                    <ProgressBar Grid.Row="1" x:Name="Progress" Style="{StaticResource Pb}"
                                 Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0" />
                </Grid>

                <!-- action bar -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="ToggleLog" Content="显示日志"
                            Style="{StaticResource Btn.Icon}" Click="ToggleLog_Click" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="OpenOutputBtn" Content="打开输出目录"
                                Style="{StaticResource Btn.Ghost}" Click="OpenOutput_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="PreviewBtn" Content="预览"
                                Style="{StaticResource Btn.Ghost}" Click="Preview_Click"
                                Margin="0,0,10,0" MinWidth="88" />
                        <Button x:Name="ExportMp4Btn" Content="导出 MP4"
                                Style="{StaticResource Btn.Ghost}" Click="ExportMp4_Click"
                                Margin="0,0,10,0" MinWidth="104"
                                ToolTip="把队列里的壁纸包直接导出为 MP4（原样拷贝，不重新编码、不裁剪）" />
                        <Button x:Name="ExtractBtn" Content="开始解包"
                                Style="{StaticResource Btn.Primary}" Click="Extract_Click"
                                MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- log overlay -->
            <Border x:Name="LogPanel" Grid.Row="1" Margin="18,0,18,18" CornerRadius="10"
                    Background="#F00B0D12" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="运行日志" Style="{StaticResource T.Title}" />
                        <Button Content="关闭" HorizontalAlignment="Right"
                                Style="{StaticResource Btn.Icon}" Click="ToggleLog_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource B.TextDim}"
                                 FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Hidden" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
