<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PkgExtractor</AssemblyName>
    <RootNamespace>PkgExtractor</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- v0.0.1 -->
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1</InformationalVersion>
    <Product>PKG Extractor</Product>
    <AssemblyTitle>PKG Extractor</AssemblyTitle>
    <Description>Wallpaper Engine .pkg / .mpkg extractor with TEX decoding</Description>
    <Company>YG</Company>
    <Copyright>Copyright © 2026</Copyright>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF's font cache builds CultureInfo("en") eagerly, so invariant globalization must stay off. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WPF needs its native companions extracted next to the app for single-file publishing. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
