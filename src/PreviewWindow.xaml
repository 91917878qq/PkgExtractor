<Window x:Class="PkgExtractor.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="预览 · PKG Extractor"
        Width="1120" Height="740"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource F.Ui}"
        Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="解包预览" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#1F6C8CFF" CornerRadius="4" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelBadge" Text="全选" FontSize="10.5"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="PathText" Margin="14,0,0,0"
                           FontSize="11" Foreground="{StaticResource B.TextFaint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CapMin" Style="{StaticResource Btn.Icon}" Content="—" Click="Min_Click" />
                    <Button x:Name="CapClose" Style="{StaticResource Btn.Icon}" Content="✕" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="320" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="1*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- left: tree -->
                <Border Grid.Column="0" Background="{StaticResource B.Surface}" CornerRadius="8"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,10,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TreeTitle" Grid.Column="0" Text="内容" FontSize="12.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />

                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="全选"
                                    Padding="9,3" FontSize="11" Margin="0,0,6,0" Click="SelectAll_Click" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="全不选"
                                    Padding="9,3" FontSize="11" Click="SelectNone_Click" />
                        </Grid>

                        <TreeView x:Name="Tree" Grid.Row="1" Margin="6,0,6,8"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItemChanged="Tree_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                    <Setter Property="Padding" Value="2" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#334A66CC" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Click="NodeCheck_Click" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SizeHint}" FontSize="10.5" Margin="8,0,0,0"
                                                   Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="False" />

                <!-- right: preview -->
                <Border Grid.Column="2" Background="{StaticResource B.Surface}" CornerRadius="8"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="PreviewTitle" Text="选择左侧文件查看预览"
                                   Margin="12,10,12,8" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Row="1" Margin="12,0,12,10" Background="{StaticResource B.Bg}"
                                CornerRadius="6" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <MediaElement x:Name="PreviewMedia" Visibility="Collapsed"
                                              Stretch="Uniform" Margin="8"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              ScrubbingEnabled="True" />

                                <TextBlock x:Name="PreviewPlaceholder" Text="无预览"
                                           FontSize="12" Foreground="{StaticResource B.TextFaint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <ScrollViewer x:Name="TextScroll" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto" Padding="10">
                                    <TextBox x:Name="PreviewText" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" Foreground="{StaticResource B.TextDim}"
                                             FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                             TextWrapping="NoWrap" AcceptsReturn="True" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" x:Name="PreviewMeta" Margin="12,0,12,10"
                                   FontSize="10.5" Foreground="{StaticResource B.TextFaint}"
                                   TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" x:Name="MediaBar" Orientation="Horizontal"
                                    Margin="12,0,12,10" Visibility="Collapsed">
                            <Button x:Name="PlayBtn" Style="{StaticResource Btn.Ghost}" Content="播放"
                                    Padding="12,4" FontSize="11" Margin="0,0,8,0" Click="Play_Click" />
                            <Slider x:Name="PosSlider" Width="240" VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True" ValueChanged="PosSlider_ValueChanged" />
                            <TextBlock x:Name="TimeText" Text="0:00 / 0:00" FontSize="10.5"
                                       Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="2" Background="{StaticResource B.Surface}" CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Margin="0,14,0,0">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="保存到" Style="{StaticResource T.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBox Grid.Column="1" x:Name="OutputBox" Height="32" VerticalContentAlignment="Center"
                             Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Border}"
                             Foreground="{StaticResource B.Text}" Padding="9,0" FontSize="12"
                             BorderThickness="1" />

                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="浏览…"
                            Margin="8,0,10,0" Padding="12,6" Click="Browse_Click" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Ghost}" Content="取消" Margin="0,0,8,0"
                                Padding="18,7" Click="Close_Click" />
                        <Button x:Name="SaveBtn" Style="{StaticResource Btn.Primary}" Content="保存选中"
                                Padding="22,7" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
